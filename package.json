{
  "name": "agentdock",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source runtime for orchestrating multiple AI coding agents across isolated git worktrees.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo",
    "cli": "pnpm --filter @agentdock/cli run start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
